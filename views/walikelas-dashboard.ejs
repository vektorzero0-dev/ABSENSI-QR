<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Wali Kelas - Presensi Digital</title>
    
<!-- Konfigurasi Suppress Warning Tailwind CDN -->
<script>
  window.tailwind = {
    config: {
      suppressWarning: true
    }
  }
</script>
<script src="https://cdn.tailwindcss.com"></script>

<!-- Script Utama Dashboard Wali Kelas -->
<script>
  // Ambil userId dari konteks EJS
  const currentUserId = "<%= userId %>";

  // 1. Fungsi Cek Status WA secara Berkala
  function cekStatusWA() {
    fetch(`/api/wa-status?userId=${currentUserId}`)
      .then(res => {
        if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
        return res.json();
      })
      .then(data => {
        if (data && data.success) {
          const status = data.statusWA || 'BELUM_TERHUBUNG';
          const qr = data.qrCodeWA || null;
          const pairing = data.pairingCode || null;

          // Update Teks Status
          const statusEl = document.getElementById('statusWAText');
          if (statusEl) statusEl.innerText = status;

          // Update Kontainer QR / Kode Pairing
          const qrContainer = document.getElementById('qrCodeContainer');
          if (qrContainer) {
            if (qr) {
              qrContainer.innerHTML = `<img src="${qr}" class="w-48 h-48 mx-auto border p-2 rounded-lg bg-white shadow-sm" alt="QR Code WA">`;
            } else if (pairing) {
              qrContainer.innerHTML = `
                <div class="bg-blue-50 border border-blue-200 text-blue-800 p-4 rounded-xl text-center">
                  <p class="text-xs font-semibold uppercase mb-1">Kode Tautan Anda:</p>
                  <span class="text-2xl font-mono font-bold tracking-widest text-blue-600">${pairing}</span>
                </div>`;
            } else if (status === 'TERHUBUNG') {
              qrContainer.innerHTML = `
                <div class="text-green-600 font-bold text-center p-4">
                  <i class="fa-solid fa-circle-check text-4xl mb-2"></i>
                  <p>WhatsApp Berhasil Terhubung!</p>
                </div>`;
            }
          }
        }
      })
      .catch(err => {
        console.warn("Cek status WA tertunda:", err.message);
      });
  }

  // 2. Fungsi Meminta Kode Pairing
  function mintaPairingWA() {
    const phoneInput = document.getElementById('nomorHPWA');
    if (!phoneInput || !phoneInput.value.trim()) {
      alert("Masukkan nomor WhatsApp terlebih dahulu!");
      return;
    }

    const phone = phoneInput.value.trim();
    fetch(`/api/request-pairing?userId=${currentUserId}&phone=${encodeURIComponent(phone)}`)
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert("Permintaan kode tautan dikirim. Silakan tunggu...");
          cekStatusWA();
        } else {
          alert("Gagal: " + (data.message || "Terjadi kesalahan."));
        }
      })
      .catch(err => {
        alert("Gagal terhubung ke server.");
      });
  }

  // 3. Fungsi Reset Sesi WA
  function resetSesiWA() {
    if (!confirm("Apakah Anda yakin ingin mereset sesi WhatsApp?")) return;

    fetch(`/api/reset-wa?userId=${currentUserId}`)
      .then(res => res.json())
      .then(data => {
        alert(data.message || "Sesi berhasil direset.");
        cekStatusWA();
      })
      .catch(err => {
        alert("Gagal mereset sesi.");
      });
  }

  // Jalankan polling otomatis setiap 5 detik setelah DOM siap
  document.addEventListener('DOMContentLoaded', () => {
    cekStatusWA();
    setInterval(cekStatusWA, 5000);
  });
</script>

    <!-- CONTAINER UTAMA -->
    <div class="max-w-7xl mx-auto px-4 mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- KOLOM KIRI: STATUS WA & OPSIONAL PENGIRIM -->
        <div class="lg:col-span-1 space-y-6">
            
            <!-- CARD STATUS WHATSAPP -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
                <h3 class="text-base font-bold text-slate-800 mb-3 flex items-center justify-between">
                    <span><i class="fa-brands fa-whatsapp text-emerald-500 text-xl mr-2"></i> Status Gateway WA</span>
                    <span id="statusWAText" class="text-xs px-2.5 py-1 rounded-full font-bold bg-slate-100 text-slate-600 uppercase">
                        <%= statusWA %>
                    </span>
                </h3>
                <hr class="mb-4">

                <!-- KONTAINER QR / PAIRING CODE -->
                <div id="qrCodeContainer" class="flex flex-col items-center justify-center min-h-[200px] bg-slate-50 border-2 border-dashed border-slate-200 rounded-xl p-4 mb-4 text-center">
                    <% if (qrCodeWA) { %>
                        <img src="<%= qrCodeWA %>" class="w-48 h-48 border p-2 rounded-lg bg-white shadow-sm" alt="QR Code WA">
                    <% } else if (statusWA === 'TERHUBUNG') { %>
                        <div class="text-emerald-600 font-bold p-4">
                            <i class="fa-solid fa-circle-check text-5xl mb-2"></i>
                            <p class="text-sm">WhatsApp Berhasil Terhubung!</p>
                        </div>
                    <% } else { %>
                        <p class="text-xs text-slate-400">Memuat status atau QR Code...</p>
                    <% } %>
                </div>

                <!-- FORM PAIRING CODE / RESET -->
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Tautkan Via Nomor HP (Pairing Code):</label>
                        <div class="flex gap-2">
                            <input type="text" id="nomorHPWA" placeholder="Contoh: 081234567890" class="w-full text-xs px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <button onclick="mintaPairingWA()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-2 rounded-lg whitespace-nowrap transition">
                                Minta Kode
                            </button>
                        </div>
                    </div>
                    <button onclick="resetSesiWA()" class="w-full bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold py-2 rounded-lg transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-rotate-right"></i> Reset Sesi WhatsApp
                    </button>
                </div>
            </div>

            <!-- CARD OPSIONAL PENGIRIM WA DARI ADMIN -->
            <% if (izinkanGuruPilihWA === 'YA') { %>
                <div class="bg-white rounded-2xl shadow-sm border border-purple-200 p-5">
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-gear text-purple-600"></i> Opsi Pengirim WA
                    </h4>
                    <p class="text-xs text-slate-500 mb-3">Pilih server WA pengirim notifikasi absensi siswa kelas Anda.</p>
                    <select id="selectModeWA" class="w-full text-xs p-2.5 border rounded-lg bg-slate-50 font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <option value="SENDIRI" <%= user.mode_pengirim_wa === 'SENDIRI' ? 'selected' : '' %>>Gunakan WA Saya Sendiri</option>
                        <option value="ADMIN" <%= user.mode_pengirim_wa === 'ADMIN' ? 'selected' : '' %>>Gunakan WA Server Pusat (Admin)</option>
                    </select>
                </div>
            <% } %>

        </div>

        <!-- KOLOM KANAN: DAFTAR SISWA & RIWAYAT HADIR HARI INI -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- TRIBUN UTAMA: RIWAYAT ABSENSI HARI INI -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-indigo-600"></i>
                        Presensi Kehadiran Hari Ini
                    </h3>
                    <a href="/scan?userId=<%= userId %>" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition flex items-center gap-2 shadow-sm">
                        <i class="fa-solid fa-qrcode"></i> Buka Kamera Scanner
                    </a>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b">
                            <tr>
                                <th class="p-3">No</th>
                                <th class="p-3">Nama Siswa</th>
                                <th class="p-3">Kelas</th>
                                <th class="p-3">Waktu Scan</th>
                                <th class="p-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (absensiHariIni && absensiHariIni.length > 0) { %>
                                <% absensiHariIni.forEach((a, idx) => { %>
                                    <tr class="hover:bg-slate-50/80">
                                        <td class="p-3 font-semibold text-slate-400"><%= idx + 1 %></td>
                                        <td class="p-3 font-bold text-slate-700"><%= a.nama_siswa %></td>
                                        <td class="p-3 text-slate-500"><%= a.nama_kelas %></td>
                                        <td class="p-3 text-slate-600 font-mono"><%= a.waktu_formatted %></td>
                                        <td class="p-3 text-center">
                                            <span class="bg-emerald-100 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-[10px]">HADIR</span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="p-6 text-center text-slate-400 italic">Belum ada data presensi siswa untuk hari ini.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- DAFTAR SISWA KELAS -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
                <h3 class="font-bold text-slate-800 text-base mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-users text-indigo-600"></i>
                    Daftar Siswa Kelas (<%= user.nama_kelas %>)
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <% if (siswaList && siswaList.length > 0) { %>
                        <% siswaList.forEach(s => { %>
                            <div class="p-3 rounded-xl border border-slate-100 bg-slate-50/50 flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-slate-800"><%= s.nama %></p>
                                    <p class="text-[11px] text-slate-500">WA Ortu: <%= s.nomor_wa_ortu || '-' %></p>
                                </div>
                                <img src="<%= s.qrImage %>" class="w-10 h-10 border p-0.5 rounded bg-white" alt="QR Kartu">
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-2 text-center text-xs text-slate-400 py-4">Tidak ada siswa terdaftar di kelas ini.</div>
                    <% } %>
                </div>
            </div>

        </div>
    </div>

    <!-- SCRIPT CLIENT-SIDE -->
    <script>
        const currentUserId = "<%= userId %>";

        // 1. Fungsi Cek Status WA (Aman dari Unexpected JSON)
        function cekStatusWA() {
            fetch(`/api/wa-status?userId=${currentUserId}`)
                .then(res => {
                    if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
                    return res.json();
                })
                .then(data => {
                    if (data && data.success) {
                        const status = data.statusWA || 'BELUM_TERHUBUNG';
                        const qr = data.qrCodeWA || null;
                        const pairing = data.pairingCode || null;

                        const statusEl = document.getElementById('statusWAText');
                        if (statusEl) statusEl.innerText = status;

                        const qrContainer = document.getElementById('qrCodeContainer');
                        if (qrContainer) {
                            if (qr) {
                                qrContainer.innerHTML = `<img src="${qr}" class="w-48 h-48 border p-2 rounded-lg bg-white shadow-sm" alt="QR Code WA">`;
                            } else if (pairing) {
                                qrContainer.innerHTML = `
                                    <div class="bg-blue-50 border border-blue-200 text-blue-800 p-4 rounded-xl text-center">
                                        <p class="text-xs font-semibold uppercase mb-1">Kode Tautan Anda:</p>
                                        <span class="text-2xl font-mono font-bold tracking-widest text-blue-600">${pairing}</span>
                                    </div>`;
                            } else if (status === 'TERHUBUNG') {
                                qrContainer.innerHTML = `
                                    <div class="text-emerald-600 font-bold p-4 text-center">
                                        <i class="fa-solid fa-circle-check text-4xl mb-2"></i>
                                        <p class="text-xs">WhatsApp Berhasil Terhubung!</p>
                                    </div>`;
                            }
                        }
                    }
                })
                .catch(err => {
                    console.warn("Status WA tertunda:", err.message);
                });
        }

        // 2. Minta Kode Pairing
        function mintaPairingWA() {
            const phoneInput = document.getElementById('nomorHPWA');
            if (!phoneInput || !phoneInput.value.trim()) {
                alert("Masukkan nomor WhatsApp terlebih dahulu!");
                return;
            }

            const phone = phoneInput.value.trim();
            fetch(`/api/request-pairing?userId=${currentUserId}&phone=${encodeURIComponent(phone)}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert("Permintaan kode tautan dikirim. Silakan tunggu...");
                        cekStatusWA();
                    } else {
                        alert("Gagal: " + (data.message || "Terjadi kesalahan."));
                    }
                })
                .catch(() => alert("Gagal terhubung ke server."));
        }

        // 3. Reset Sesi WA
        function resetSesiWA() {
            if (!confirm("Apakah Anda yakin ingin mereset sesi WhatsApp?")) return;

            fetch(`/api/reset-wa?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    alert(data.message || "Sesi berhasil direset.");
                    cekStatusWA();
                })
                .catch(() => alert("Gagal mereset sesi."));
        }

        // Polling setiap 5 detik
        document.addEventListener('DOMContentLoaded', () => {
            cekStatusWA();
            setInterval(cekStatusWA, 5000);
        });
    </script>
</body>
</html>
